# Public application identifiers only. NEVER use a Supabase secret/service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Google Cloud OAuth Web client ID, with Gmail API and authorized JS origins enabled.
VITE_GOOGLE_CLIENT_ID=
# Solar Connect macOS: public IDs are exposed to the frontend.
# Google OAuth Desktop client; enable the Google APIs requested by the catalog.
VITE_GOOGLE_DESKTOP_CLIENT_ID=
# Google Desktop also requires its issued client parameter for code/refresh exchange.
# Build-only, read by Rust from ignored .env.local; NEVER prefix this with VITE_.
# Desktop OAuth remains a public client: the compiled application cannot hide it.
SOLAR_GOOGLE_DESKTOP_CLIENT_SECRET=
# Microsoft Entra public desktop client, multi-tenant + personal accounts.
# Mobile/desktop redirect: http://localhost (runtime uses a random loopback port).
VITE_MICROSOFT_CLIENT_ID=
# GitHub App client ID, Device Flow enabled; Contents read, Issues/Pull requests write.
VITE_GITHUB_APP_CLIENT_ID=
# Public OAuth IDs. Register the exact loopback redirects with each provider.
VITE_LINEAR_CLIENT_ID=
VITE_LINEAR_REDIRECT_URI=http://127.0.0.1:18765/oauth/callback
# Slack application must opt in to public-client PKCE (user scopes only).
VITE_SLACK_CLIENT_ID=
VITE_SLACK_REDIRECT_URI=http://localhost:18766/oauth/callback
VITE_NOTION_CLIENT_ID=
VITE_NOTION_REDIRECT_URI=http://127.0.0.1:18767/oauth/callback
VITE_DISCORD_CLIENT_ID=
VITE_DISCORD_REDIRECT_URI=http://127.0.0.1:18768/oauth/callback
# HTTPS base URL ending in /oauth. Secrets stay in server environment only.
VITE_SOLAR_OAUTH_BROKER=
# Public HTTPS endpoint of the authenticated billing API, once deployed and verified.
VITE_SOLAR_BILLING_URL=
# Allow this exact URL in Supabase Auth redirect URLs.
VITE_SOLAR_AUTH_REDIRECT_URL=
