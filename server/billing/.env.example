# SERVER ONLY: configure these as secrets in Vercel; never prefix with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Modern sb_secret_ server key preferred; legacy service_role JWT also supported.
SUPABASE_SERVICE_ROLE_KEY=
# Prefer a restricted rk_ key with only the required billing permissions.
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVEMODE=false
# Isolated sandbox prices only. Live price IDs are fixed in config.mjs.
STRIPE_PRO_PRICE_ID=
STRIPE_MAX_PRICE_ID=
SOLAR_BILLING_PUBLIC_URL=https://solar-billing.vercel.app
SOLAR_BILLING_ALLOWED_ORIGINS=http://127.0.0.1:1420
STRIPE_PORTAL_CONFIGURATION_ID=
# Franchise en base confirmed by James on 25 October 2026.
# Switch to automatic only after updating tax registrations and invoice terms.
SOLAR_TAX_MODE=exempt
